# --- 포털 앱 ---
# 브라우저가 접근하는 주소. Keycloak의 redirect_uri 등록값과 정확히 일치해야 한다.
APP_BASE_URL=http://localhost:3100
PORT=3100
HOST=0.0.0.0

# 세션 쿠키 서명 키. 반드시 새로 생성하라: openssl rand -base64 32
SESSION_SECRET=dev-only-session-secret-at-least-32-chars

# --- Keycloak (OIDC) ---
OIDC_ISSUER=http://localhost:8080/realms/mega
OIDC_CLIENT_ID=portal
# 운영에서는 Keycloak 관리 콘솔에서 재발급하라.
OIDC_CLIENT_SECRET=portal-dev-secret-change-me

# --- 포털 메타데이터 DB (계정은 Keycloak이 소유한다) ---
# 호스트 5432는 로컬 PostgreSQL이 쓰고 있어 컨테이너는 5433으로 노출한다.
DATABASE_URL=postgres://portal:portal@localhost:5433/portal

# --- docker/compose.yml 용 ---
POSTGRES_PASSWORD=postgres
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB_PASSWORD=keycloak
KEYCLOAK_HOSTNAME=http://localhost:8080
