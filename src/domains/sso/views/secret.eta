<%/* 평문 secret은 이 화면에만 존재한다. 새로고침하면 다시 볼 수 없다. */%>
<section id="sso-secret" <% if (it.oob) { %>hx-swap-oob="true"<% } %>>
  <% if (it.secret) { %>
  <div class="panel">
    <h2>client secret — 지금 한 번만 보인다</h2>
    <p class="muted">
      <code><%= it.secret.clientId %></code> 의 secret이다.
      하위 앱 설정에 옮겨 담아라. 잃어버리면 재발급만 가능하다.
    </p>
    <p><code><%= it.secret.value %></code></p>
  </div>
  <% } %>
</section>
