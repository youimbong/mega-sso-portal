{
  "name": "mega-sso-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "infra:up": "node scripts/render-realm.mjs && docker compose -f docker/compose.yml up -d",
    "infra:down": "docker compose -f docker/compose.yml down",
    "infra:logs": "docker compose -f docker/compose.yml logs -f",
    "realm:render": "node scripts/render-realm.mjs",
    "realm:sync-client": "node scripts/sync-realm-client.mjs",
    "pm2:start": "pnpm build && pm2 start ecosystem.config.cjs",
    "pm2:reload": "pnpm build && pm2 reload ecosystem.config.cjs",
    "pm2:stop": "pm2 stop mega-sso-portal",
    "pm2:logs": "pm2 logs mega-sso-portal"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/formbody": "9.0.0",
    "@fastify/helmet": "13.1.0",
    "@fastify/static": "10.1.3",
    "@fastify/view": "12.0.0",
    "drizzle-orm": "0.45.2",
    "eta": "4.6.0",
    "fastify": "5.11.3",
    "jose": "6.2.8",
    "openid-client": "6.8.5",
    "postgres": "3.4.9",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "drizzle-kit": "0.31.10",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
